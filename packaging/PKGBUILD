# Maintainer: funkypitt <pierregallaz@gmail.com>
# Arch / Manjaro: cd packaging && makepkg -si
pkgname=readers-books
pkgver=1.5.0
pkgrel=1
pkgdesc="Black-and-white e-book reader: a shelf as a plain list, pages cut at whole lines, an optional library on a drive"
arch=('any')
url="https://github.com/funkypitt/readers-books-desktop"
license=('MIT')
depends=('python' 'python-pyqt5' 'python-requests')
source=("$pkgname-$pkgver.tar.gz::https://github.com/funkypitt/readers-books-desktop/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/readers-books-desktop-$pkgver"
  install -Dm755 readers_books.py "$pkgdir/usr/lib/readers-books/readers_books.py"
  for f in packaging/fonts/*; do install -Dm644 "$f" "$pkgdir/usr/lib/readers-books/fonts/$(basename "$f")"; done
  install -Dm644 packaging/readers-books.png "$pkgdir/usr/lib/readers-books/readers-books.png"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/readers-books" <<'SH'
#!/bin/sh
exec python3 /usr/lib/readers-books/readers_books.py "$@"
SH
  install -Dm644 packaging/readers-books.desktop "$pkgdir/usr/share/applications/readers-books.desktop"
  install -Dm644 packaging/readers-books.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/readers-books.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
